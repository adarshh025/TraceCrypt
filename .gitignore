!data/keys/.gitkeep
data/documents/*
!data/documents/.gitkeep
data/ledger/*
!data/ledger/.gitkeep
data/reports/*
!data/reports/.gitkeep

# Sensitive Document Files & Distribution Packages
*.tcdist
*.pdf
!tests/fixtures/*.pdf

