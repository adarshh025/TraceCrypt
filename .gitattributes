# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Force specific text files to LF
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.tcdist binary
*.tckeystore binary
*.whl binary
