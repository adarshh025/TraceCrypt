{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceCryptConfiguration",
  "type": "object",
  "required": ["system", "crypto", "ledger", "security", "forensics"],
  "properties": {
    "system": {
      "type": "object",
      "required": ["environment", "data_directory", "log_directory", "airgap_enforced"],
      "properties": {
        "environment": { "type": "string", "enum": ["production", "development", "test", "benchmark"] },
        "data_directory": { "type": "string" },
        "log_directory": { "type": "string" },
        "airgap_enforced": { "type": "boolean" }
      }
    },
    "crypto": {
      "type": "object",
      "required": ["kem_algorithm", "signature_algorithm", "hash_algorithm", "kdf"],
      "properties": {
        "kem_algorithm": { "type": "string", "enum": ["ML-KEM-768"] },
        "signature_algorithm": { "type": "string", "enum": ["ML-DSA-65"] },
        "hash_algorithm": { "type": "string", "enum": ["SHA3-256"] },
        "kdf": { "type": "string", "enum": ["Argon2id"] }
      }
    },
    "ledger": {
      "type": "object",
      "required": ["chain_id", "quorum_threshold", "block_interval_ms", "max_byzantine_faults"],
      "properties": {
        "chain_id": { "type": "string" },
        "quorum_threshold": { "type": "integer", "minimum": 3 },
        "block_interval_ms": { "type": "integer", "minimum": 100 },
        "max_byzantine_faults": { "type": "integer", "minimum": 1 }
      }
    },
    "security": {
      "type": "object",
      "required": ["zeroization", "replay_protection", "certificate_validation"],
      "properties": {
        "zeroization": { "type": "boolean" },
        "replay_protection": { "type": "boolean" },
        "certificate_validation": { "type": "string", "enum": ["STRICT_FAIL_CLOSED"] }
      }
    },
    "forensics": {
      "type": "object",
      "required": ["watermark_algorithm", "ecc_algorithm", "min_psnr_db"],
      "properties": {
        "watermark_algorithm": { "type": "string", "enum": ["DWT-DCT-SPREAD-SPECTRUM"] },
        "ecc_algorithm": { "type": "string", "enum": ["RS(32,16)"] },
        "min_psnr_db": { "type": "number", "minimum": 40.0 }
      }
    }
  }
}
