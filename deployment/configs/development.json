{
  "$schema": "https://tracecrypt.internal/schemas/config-v1.json",
  "system": {
    "mode": "DEVELOPMENT",
    "data_dir": "data_dev",
    "log_level": "DEBUG"
  },
  "airgap": {
    "enforce_airgap": true,
    "allow_dns": false,
    "allowed_hosts": ["127.0.0.1", "localhost", "::1"]
  },
  "crypto": {
    "kem_algorithm": "ML-KEM-768",
    "dsa_algorithm": "ML-DSA-65",
    "hash_algorithm": "sha3-256",
    "argon2_memory_mb": 16,
    "argon2_iterations": 1,
    "argon2_parallelism": 1
  },
  "ledger": {
    "cluster_id": "tracecrypt-dev-cluster",
    "validator_count": 4,
    "block_finality_seconds": 0.5,
    "rpc_host": "127.0.0.1",
    "rpc_port": 8545
  },
  "logging": {
    "level": "DEBUG",
    "json_format": false,
    "redact_secrets": true
  }
}
